{%- doc -%}
  Renders one article card for the Learn page's combined, filterable article grid.
  Rendered via `render` (not a theme block) from sections/bfbella-learn-articles.liquid, since
  the parent section needs to pass in per-article computed values (category label/key, an
  estimated read time, a resolved excerpt) at the point of render — snippets support passed
  parameters, theme blocks don't, so this is the correct mechanism here, not a workaround.

  @param {object} article - the Shopify Article object
  @param {string} category_label - the display label of the category (blog) this came from
  @param {string} category_key - handleized version of category_label, used for JS filtering
  @param {number} read_minutes - estimated read time in minutes (word-count based, not native)
  @param {string} excerpt - resolved excerpt text (article.excerpt or truncated content)

  @example
  {% render 'bfbella-learn-article-card', article: article, category_label: cat_label, category_key: cat_key, read_minutes: read_minutes, excerpt: excerpt %}
{%- enddoc -%}

<a href="{{ article.url }}" class="bfbella-learn-article-card" data-category="{{ category_key }}">
  {%- if article.image -%}
    <div class="bfbella-learn-article-card__media">
      <img
        src="{{ article.image | image_url: width: 500 }}"
        alt="{{ article.image.alt | escape }}"
        loading="lazy"
        width="500"
        height="{{ 500 | divided_by: article.image.aspect_ratio }}"
      >
      <span class="bfbella-learn-article-card__time">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        {{ read_minutes }} min
      </span>
    </div>
  {%- endif -%}
  <div class="bfbella-learn-article-card__content">
    <span class="bfbella-learn-article-card__category">{{ category_label }}</span>
    <h3 class="bfbella-learn-article-card__title">{{ article.title }}</h3>
    <p class="bfbella-learn-article-card__excerpt">{{ excerpt }}</p>
    <div class="bfbella-learn-article-card__footer">
      <span class="bfbella-learn-article-card__author">{{ article.author }}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12,5 19,12 12,19"/>
      </svg>
    </div>
  </div>
</a>

{% stylesheet %}
  .bfbella-learn-article-card[hidden] {
    display: none;
  }

  .bfbella-learn-article-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 1.25rem;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
  }

  .bfbella-learn-article-card:hover {
    transform: translateY(-4px);
    border-color: var(--bfbella-accent);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1);
  }

  .bfbella-learn-article-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .bfbella-learn-article-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .bfbella-learn-article-card:hover .bfbella-learn-article-card__media img {
    transform: scale(1.1);
  }

  .bfbella-learn-article-card__time {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }

  .bfbella-learn-article-card__time svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .bfbella-learn-article-card__content {
    padding: 1.5rem;
  }

  .bfbella-learn-article-card__category {
    color: var(--bfbella-accent);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .bfbella-learn-article-card__title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    margin-block: 0.5rem;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bfbella-learn-article-card__excerpt {
    font-size: 0.9rem;
    line-height: 1.55;
    opacity: 0.7;
    margin-block-end: 1rem;

    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bfbella-learn-article-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
  }

  .bfbella-learn-article-card__author {
    opacity: 0.6;
  }

  .bfbella-learn-article-card__footer svg {
    width: 1rem;
    height: 1rem;
    color: var(--bfbella-accent);
    transition: transform 0.2s;
  }

  .bfbella-learn-article-card:hover .bfbella-learn-article-card__footer svg {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .bfbella-learn-article-card,
    .bfbella-learn-article-card__media img,
    .bfbella-learn-article-card__footer svg {
      transition: none;
    }
  }
{% endstylesheet %}
