{%- doc -%}
  BFBella custom shop grid card — image, title, description excerpt, price, Add to Cart, Buy Now,
  and an explicit View Details button.

  Add to Cart and Buy Now both submit the same real add-to-cart mechanism (product-form-component
  + native form, same as the working PDP button) — per DXB, Add to Cart adds silently, Buy Now
  adds AND force-opens the cart drawer. The drawer-open behavior for Buy Now is wired in the
  parent section's javascript block (sections/bfbella-shop-collection.liquid) via a
  click-armed/event-consumed listener on `[data-bfbella-buy-now]`, not here — this snippet only
  marks the button so that listener can find it.

  A true native accelerated/dynamic checkout button (payment_button) was tried first for "Buy
  Now" but reverted: checkout always resolves against the store's registered primary domain
  regardless of which theme is being previewed, and that domain currently serves the old
  storefront app rather than Shopify natively, so any checkout-bound button 404s today through no
  fault of this code. DXB's actual desired behavior (add + open drawer, not skip to checkout)
  sidesteps that problem entirely, which is why this simpler approach was adopted instead.

  @param {object} product - The product to render
  @param {object} section - The parent section (for card_background_color/card_text_color/
    card_border_radius settings)

  @example
  {% render 'bfbella-shop-product-card', product: product, section: section %}
{%- enddoc -%}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign has_sale = false
  if variant.compare_at_price > variant.price
    assign has_sale = true
  endif
  assign add_form_id = 'BfbellaShopAdd-' | append: product.id
  assign add_to_cart_label = 'actions.add_to_cart' | t
  assign buy_now_form_id = 'BfbellaShopBuyNow-' | append: product.id
%}

<div
  class="bfbella-shop-card"
  style="
    --bfbella-card-bg: {{ section.settings.card_background_color | default: settings.color_palette.background }};
    --bfbella-card-text: {{ section.settings.card_text_color | default: settings.color_palette.foreground }};
    --bfbella-card-radius: {{ section.settings.card_border_radius | default: 18 }}px;
    --bfbella-button-radius: {{ section.settings.button_border_radius | default: 6 }}px;
    --bfbella-add-btn-bg: {{ section.settings.add_to_cart_button_color | default: settings.color_palette.color3 }};
    --bfbella-add-btn-text: {{ section.settings.add_to_cart_button_text_color | default: settings.color_palette.background }};
    --bfbella-buynow-text: {{ section.settings.buy_now_button_text_color | default: settings.color_palette.foreground }};
  "
>
  <a href="{{ product.url }}" class="bfbella-shop-card__media">
    {% if product.featured_media %}
      {{
        product.featured_media
        | image_url: width: 600
        | image_tag: loading: 'lazy', widths: '300, 450, 600', class: 'bfbella-shop-card__image'
      }}
    {% endif %}
    {% if has_sale %}
      <span class="bfbella-shop-card__badge">Sale</span>
    {% endif %}
  </a>
  <div class="bfbella-shop-card__content">
    <a href="{{ product.url }}" class="bfbella-shop-card__title">{{ product.title }}</a>
    {% if product.description != blank %}
      <p class="bfbella-shop-card__excerpt">{{ product.description | strip_html | truncate: 110 }}</p>
    {% endif %}
    <div class="bfbella-shop-card__price">
      <span>{{ variant.price | money }}</span>
      {% if has_sale %}
        <s class="bfbella-shop-card__compare-price">{{ variant.compare_at_price | money }}</s>
      {% endif %}
    </div>
    <div class="bfbella-shop-card__actions">
      {% render 'add-to-cart-button-styles' %}
      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        on:submit="/handleSubmit"
        class="bfbella-shop-card__add-form"
      >
        <div
          class="visually-hidden"
          aria-live="assertive"
          role="status"
          aria-atomic="true"
          ref="liveRegion"
        ></div>
        {% form 'product', product, id: add_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
          <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <add-to-cart-component ref="addToCartButtonContainer">
            <button
              type="submit"
              name="add"
              ref="addToCartButton"
              on:click="/handleClick"
              class="button bfbella-shop-card__add-button"
              {% unless variant.available %}disabled{% endunless %}
            >
              <span aria-hidden="true" class="svg-wrapper bfbella-shop-card__add-icon">
                {{- 'icon-shopping-cart.svg' | inline_asset_content -}}
              </span>
              <span>{{ add_to_cart_label }}</span>
              <span class="add-to-cart__added">
                <span class="svg-wrapper add-to-cart__added-icon">
                  {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
                </span>
              </span>
            </button>
          </add-to-cart-component>
        {% endform %}
      </product-form-component>
      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        on:submit="/handleSubmit"
        class="bfbella-shop-card__buynow-form"
      >
        <div
          class="visually-hidden"
          aria-live="assertive"
          role="status"
          aria-atomic="true"
          ref="liveRegion"
        ></div>
        {% form 'product', product, id: buy_now_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
          <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <add-to-cart-component ref="addToCartButtonContainer">
            <button
              type="submit"
              name="add"
              ref="addToCartButton"
              on:click="/handleClick"
              class="button bfbella-shop-card__buynow-button"
              data-bfbella-buy-now
              {% unless variant.available %}disabled{% endunless %}
            >
              <span>Buy Now</span>
              <span class="add-to-cart__added">
                <span class="svg-wrapper add-to-cart__added-icon">
                  {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
                </span>
              </span>
            </button>
          </add-to-cart-component>
        {% endform %}
      </product-form-component>
    </div>
    <a href="{{ product.url }}" class="bfbella-shop-card__view-details">View Details</a>
  </div>
</div>
