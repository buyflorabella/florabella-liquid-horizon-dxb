{% comment %}
  ============================================================================
  Contact Page — Opportunities (Brand Ambassadors / Wholesale, task 0009)
  ============================================================================
  Content from ContactPage.tsx. 2-card row, each: icon + heading + text + button + small print.
  Built as a block repeater — genuinely two different "kinds" of opportunity today, and more
  could reasonably be added later (retail partnerships, affiliates, etc.) without new section
  fields.

  WHAT THIS FILE NEEDS ALONGSIDE IT:
    - blocks/bfbella-opportunity-card.liquid
  Renders itself entirely — this section only does `{% content_for 'blocks' %}`.

  CONTENT: zero real copy hardcoded — every field is a blank native setting until filled in via
  templates/page.contact.json. See 0009_task1_howto.md for production text.

  COLOR: no hardcoded hex. Accent resolves through `section.settings.accent_color`, falling
  back to `color_palette.color3`. Background resolves through
  `section.settings.background_color`, falling back to `color_palette.color7` (dark, matching
  the Contact Intro section above it).

  DEPLOY: written directly into this live repo's working tree as part of the 2026-09-07
  live-edit pilot (see claude_docs/build_docs/live_edit_pilot_plan.md) — DXB reviews, then
  commits and pushes by hand.
  ============================================================================
{% endcomment %}

{% liquid
  assign accent = section.settings.accent_color | default: settings.color_palette.color3
  assign bg = section.settings.background_color | default: settings.color_palette.color7

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif
%}

<div
  id="ContactOpportunities-{{ section.id }}"
  class="bfbella-contact-opportunities{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --bfbella-accent: {{ accent }};
    --bfbella-bg: {{ bg }};
    {% if section.settings.padding_top != blank %}--bfbella-pad-top: {{ section.settings.padding_top }}px;{% endif %}
    {% if section.settings.padding_bottom != blank %}--bfbella-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}
  "
>
  {%- if section.blocks.size > 0 -%}
    <div class="bfbella-contact-opportunities__inner page-width">
      <div class="bfbella-contact-opportunities__grid">
        {% content_for 'blocks' %}
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .bfbella-contact-opportunities {
    position: relative;
    padding-block-start: var(--bfbella-pad-top, 0);
    padding-block-end: var(--bfbella-pad-bottom, 3rem);
    background-color: var(--bfbella-bg);
    color: #fff;
  }

  .bfbella-contact-opportunities__inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .bfbella-contact-opportunities__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BFBella — Opportunities",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "bfbella-opportunity-card"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "placeholder": "t:settings.default",
      "info": "Leave blank to use the theme's existing color3 (brand green) swatch."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "t:settings.default",
      "info": "Leave blank to use the theme's existing color7 swatch."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "BFBella — Opportunities",
      "category": "Custom",
      "blocks": [
        { "type": "bfbella-opportunity-card" },
        { "type": "bfbella-opportunity-card" }
      ]
    }
  ]
}
{% endschema %}
