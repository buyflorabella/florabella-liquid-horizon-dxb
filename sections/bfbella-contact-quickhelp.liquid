{% comment %}
  ============================================================================
  Contact Page — Quick Help sidebar (task 0009)
  ============================================================================
  Content from ContactPage.tsx: Order Help / Product Questions / Partnerships / Location, each
  a small card with a heading, text, and an optional link.

  LAYOUT NOTE: production shows this beside the contact form in a 2-column layout. This section
  stacks BELOW the existing native "form" section instead (templates/page.contact.json's `form`
  entry, already live and working — the native `contact-form` block) rather than restructuring
  that section into a row layout to make room for a true side-by-side column. Risk/reward
  call: the native form is already proven working, and forcing it into a 2-column layout here
  risked breaking it for a purely cosmetic gain. Flag if DXB wants the true side-by-side layout
  badly enough to justify that restructure as a follow-up.

  WHAT THIS FILE NEEDS ALONGSIDE IT:
    - blocks/bfbella-quickhelp-card.liquid
  Renders itself entirely — this section only does `{% content_for 'blocks' %}`.

  CONTENT: zero real copy hardcoded — every field is a blank native setting until filled in via
  templates/page.contact.json, including the Location card's icon+address (built as a card with
  no link, just text). See 0009_task1_howto.md for production text.

  COLOR: no hardcoded hex. Accent resolves through `section.settings.accent_color`, falling
  back to `color_palette.color3`. Background resolves through
  `section.settings.background_color`, falling back to `color_palette.color7`.

  DEPLOY: written directly into this live repo's working tree as part of the 2026-09-07
  live-edit pilot (see claude_docs/build_docs/live_edit_pilot_plan.md) — DXB reviews, then
  commits and pushes by hand.
  ============================================================================
{% endcomment %}

{% liquid
  assign accent = section.settings.accent_color | default: settings.color_palette.color3
  assign bg = section.settings.background_color | default: settings.color_palette.color7

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif
%}

<div
  id="ContactQuickHelp-{{ section.id }}"
  class="bfbella-contact-quickhelp{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --bfbella-accent: {{ accent }};
    --bfbella-bg: {{ bg }};
    {% if section.settings.padding_top != blank %}--bfbella-pad-top: {{ section.settings.padding_top }}px;{% endif %}
    {% if section.settings.padding_bottom != blank %}--bfbella-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}
  "
>
  <div class="bfbella-contact-quickhelp__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="bfbella-contact-quickhelp__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="bfbella-contact-quickhelp__grid">
        {% content_for 'blocks' %}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .bfbella-contact-quickhelp {
    position: relative;
    padding-block-start: var(--bfbella-pad-top, 2rem);
    padding-block-end: var(--bfbella-pad-bottom, 6rem);
    background-color: var(--bfbella-bg);
    color: #fff;
  }

  .bfbella-contact-quickhelp__inner {
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .bfbella-contact-quickhelp__heading {
    font-size: 1.75rem;
    font-weight: 700;
    margin-block-end: 1.5rem;
  }

  .bfbella-contact-quickhelp__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BFBella — Quick Help",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "bfbella-quickhelp-card"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "placeholder": "t:settings.default",
      "info": "Leave blank to use the theme's existing color3 (brand green) swatch."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "t:settings.default",
      "info": "Leave blank to use the theme's existing color7 swatch."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "BFBella — Quick Help",
      "category": "Custom",
      "blocks": [
        { "type": "bfbella-quickhelp-card" },
        { "type": "bfbella-quickhelp-card" },
        { "type": "bfbella-quickhelp-card" },
        { "type": "bfbella-quickhelp-card" }
      ]
    }
  ]
}
{% endschema %}
