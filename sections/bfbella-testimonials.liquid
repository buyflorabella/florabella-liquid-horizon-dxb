{% comment %}
  ============================================================================
  task 0003 (Task 7) — "Gardeners Are Seeing Real Change" (Testimonials)
  ============================================================================
  Fully custom section — no native Horizon section does a review-card grid with a star
  rating + gradient initials avatar. Built from scratch per DXB's explicit request.

  NOTE: this comment deliberately never spells out the Liquid tag delimiters for the
  schema or stylesheet blocks below (plain words are used instead) — see the
  2026-09-06 lesson in this project's self_improve/LESSONS.md.

  WHAT THIS FILE NEEDS ALONGSIDE IT:
    - blocks/bfbella-testimonial.liquid   (0003_task7_bfbella-testimonial.liquid)
  Renders itself entirely — this section only does `{% content_for 'blocks' %}`. Built this
  way from the start (see .claude/CLAUDE.md's "Theme Blocks Must Render Themselves").

  CONTENT: zero real copy hardcoded — heading, subheading, and every review field are blank
  native settings/block fields until DXB fills them in. See 0003_task7_howto.md for the
  exact production text (3 real reviews) and where each piece goes.

  COLOR: no hardcoded hex. Production uses a two-color gradient (lime → magenta) for the
  star rating and avatar badges — both colors resolve through this section's own settings,
  falling back to the theme's existing `color8` (lime, exact match) and `color5` (magenta,
  exact match) swatches, confirmed via config/settings_data.json. Background falls back to
  `color9` (near-black, exact match), same swatch used throughout this task series.

  DEPLOY: save as sections/bfbella-testimonials.liquid in the live theme. DXB applies this —
  Claude never commits or touches the live repo.
  ============================================================================
{% endcomment %}

{% liquid
  assign accent = section.settings.accent_color | default: settings.color_palette.color8
  assign accent_2 = section.settings.accent_color_2 | default: settings.color_palette.color5
  assign bg = section.settings.background_color | default: settings.color_palette.color9

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif
%}

<div
  id="Testimonials-{{ section.id }}"
  class="bfbella-testimonials{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    --bfbella-accent: {{ accent }};
    --bfbella-accent-2: {{ accent_2 }};
    --bfbella-bg: {{ bg }};
    {% if section.settings.padding_top != blank %}--bfbella-pad-top: {{ section.settings.padding_top }}px;{% endif %}
    {% if section.settings.padding_bottom != blank %}--bfbella-pad-bottom: {{ section.settings.padding_bottom }}px;{% endif %}
  "
>
  <div class="bfbella-testimonials__inner page-width">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="bfbella-testimonials__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="bfbella-testimonials__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="bfbella-testimonials__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="bfbella-testimonials__grid">
        {% content_for 'blocks' %}
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .bfbella-testimonials {
    position: relative;
    overflow: hidden;
    padding-block-start: var(--bfbella-pad-top, 8rem);
    padding-block-end: var(--bfbella-pad-bottom, 8rem);
    background-color: var(--bfbella-bg);
    color: #fff;
  }

  .bfbella-testimonials__inner {
    position: relative;
    z-index: 1;
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .bfbella-testimonials__intro {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    margin-block-end: 5rem;
  }

  .bfbella-testimonials__heading {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-block-end: 1.5rem;
  }

  .bfbella-testimonials__subheading {
    font-size: 1.25rem;
    color: rgb(255 255 255 / 0.6);
  }

  .bfbella-testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BFBella — Testimonials",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "bfbella-testimonial"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (stars)",
      "placeholder": "t:settings.default",
      "info": "Also the first color in the avatar badge gradient. Leave blank to use the theme's existing color8 (lime) swatch."
    },
    {
      "type": "color",
      "id": "accent_color_2",
      "label": "Accent color 2 (avatar gradient)",
      "placeholder": "t:settings.default",
      "info": "The second color in the avatar badge gradient. Leave blank to use the theme's existing color5 (magenta) swatch."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "t:settings.default",
      "info": "Leave blank to use the theme's existing color9 swatch — an exact match for production's near-black background."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 128
    }
  ],
  "presets": [
    {
      "name": "BFBella — Testimonials",
      "category": "Custom",
      "blocks": [
        { "type": "bfbella-testimonial" },
        { "type": "bfbella-testimonial" },
        { "type": "bfbella-testimonial" }
      ]
    }
  ]
}
{% endschema %}
