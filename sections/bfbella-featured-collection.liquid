{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section
  id="home-shop"
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%  render 'spacing-style', settings: section.settings %}
  "
>
  <div class="featured-collection spacing-style">
    {% if section.settings.heading != blank %}
      <div class="featured-collection__header spacing-style">
        <h2 class="featured-collection__title">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="featured-collection__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign collection = collections[section.settings.collection] %}

    {% if collection %}
      <div class="featured-collection__content">
        {% if section.settings.show_category_filter %}
          <div class="featured-collection__filters">
            <button class="featured-collection__filter-btn featured-collection__filter-btn--active" data-filter="all">
              {{ section.settings.all_label }}
            </button>
            {% if section.settings.category_1 != blank %}
              <button class="featured-collection__filter-btn" data-filter="{{ section.settings.category_1 }}">
                {{ section.settings.category_1_label }}
              </button>
            {% endif %}
            {% if section.settings.category_2 != blank %}
              <button class="featured-collection__filter-btn" data-filter="{{ section.settings.category_2 }}">
                {{ section.settings.category_2_label }}
              </button>
            {% endif %}
            {% if section.settings.category_3 != blank %}
              <button class="featured-collection__filter-btn" data-filter="{{ section.settings.category_3 }}">
                {{ section.settings.category_3_label }}
              </button>
            {% endif %}
          </div>
        {% endif %}

        <div class="featured-collection__products">
          {% assign products_to_show = section.settings.products_to_show | default: 12 %}
          {% assign product_count = 0 %}

          {% for product in collection.products limit: products_to_show %}
            {% if section.settings.show_category_filter == false or section.settings.all_label == "All" %}
              <div class="featured-collection__product-item">
                {% render 'product-card',
                  product: product,
                  media_aspect_ratio: section.settings.media_aspect_ratio,
                  image_shape: section.settings.image_shape,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating
                %}
              </div>
              {% assign product_count = product_count | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.show_view_all_button %}
          <div class="featured-collection__view-all">
            <a href="{{ collection.url }}" class="button button--primary">
              {{ section.settings.view_all_text }}
            </a>
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="featured-collection__placeholder">
        <p>{{ 'sections.featured_collection.no_collection_selected' | t }}</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .featured-collection {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .featured-collection__header {
    text-align: center;
  }

  .featured-collection__title {
    font-size: var(--font-heading-scale);
    margin: 0;
  }

  .featured-collection__subheading {
    margin: 0.5rem 0 0 0;
    opacity: 0.8;
  }

  .featured-collection__filters {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .featured-collection__filter-btn {
    padding: 0.5rem 1rem;
    border: 1px solid rgb(var(--color-border));
    background: transparent;
    border-radius: 2rem;
    cursor: pointer;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .featured-collection__filter-btn:hover {
    background: rgb(var(--color-background));
  }

  .featured-collection__filter-btn--active {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border-color: rgb(var(--color-button));
  }

  .featured-collection__products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .featured-collection__product-item {
    display: flex;
    flex-direction: column;
  }

  .featured-collection__view-all {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .featured-collection__placeholder {
    text-align: center;
    padding: 2rem;
    background: rgb(var(--color-background));
    border-radius: 0.25rem;
  }

  @media (max-width: 768px) {
    .featured-collection {
      gap: 1.5rem;
    }

    .featured-collection__products {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1rem;
    }

    .featured-collection__filters {
      gap: 0.5rem;
    }

    .featured-collection__filter-btn {
      padding: 0.375rem 0.75rem;
      font-size: 0.75rem;
    }
  }
</style>

{% schema %}
{
  "name": "BFBella — Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_category_filter",
      "label": "Show category filter",
      "default": true
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "All categories label",
      "default": "All"
    },
    {
      "type": "text",
      "id": "category_1",
      "label": "Category 1 handle",
      "default": "trace-mineral-bags"
    },
    {
      "type": "text",
      "id": "category_1_label",
      "label": "Category 1 label",
      "default": "Trace Mineral Bags"
    },
    {
      "type": "text",
      "id": "category_2",
      "label": "Category 2 handle",
      "default": "microdust"
    },
    {
      "type": "text",
      "id": "category_2_label",
      "label": "Category 2 label",
      "default": "Microdust"
    },
    {
      "type": "text",
      "id": "category_3",
      "label": "Category 3 handle",
      "default": "biostimulant"
    },
    {
      "type": "text",
      "id": "category_3_label",
      "label": "Category 3 label",
      "default": "Biostimulant"
    },
    {
      "type": "checkbox",
      "id": "show_view_all_button",
      "label": "Show View All button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All button text",
      "default": "View All Products"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": ""
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "1/1",
          "label": "Square"
        },
        {
          "value": "4/5",
          "label": "Portrait"
        },
        {
          "value": "16/9",
          "label": "Landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "arch",
          "label": "Arch"
        },
        {
          "value": "blob",
          "label": "Blob"
        },
        {
          "value": "chevronleft",
          "label": "Chevron left"
        },
        {
          "value": "chevronright",
          "label": "Chevron right"
        },
        {
          "value": "diamond",
          "label": "Diamond"
        },
        {
          "value": "parallelogram",
          "label": "Parallelogram"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "BFBella — Featured Collection"
    }
  ]
}
{% endschema %}
