{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<section
  id="home-shop"
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <collection-component>
    <div
      class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
      style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
      section-id="{{ section.id }}"
    >
      {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

      <div
        id="bfbella-featured-grid-{{ section.id }}"
        class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
      >
        {% if section.settings.collection %}
          <ul
            class="product-grid product-grid--{{ section.id }}"
            id="ResultsList"
            role="region"
            aria-live="polite"
            aria-label="{{ 'accessibility.products' | t }}"
          >
            {% for product in section.settings.collection.products limit: section.settings.products_limit %}
              <li
                id="{{ section.id }}-{{ product.id }}"
                class="product-grid__item"
              >
                {% render 'bfbella-shop-product-card', product: product, section: section %}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="placeholder-content">
            <p>{{ 'sections.featured_collection.no_products' | t }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  </collection-component>
</section>

{% stylesheet %}
  .product-grid--{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (max-width: 750px) {
    .product-grid--{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  .placeholder-content {
    padding: 3rem;
    text-align: center;
    background: rgb(var(--color-background));
    border-radius: 0.25rem;
    grid-column: 1 / -1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BFBella — Featured Coll.",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": ""
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "Grid width",
      "options": [
        {
          "value": "centered",
          "label": "Centered"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "centered"
    }
  ],
  "presets": [
    {
      "name": "BFBella — Featured Coll.",
      "settings": {
        "collection": "all",
        "products_limit": 12
      }
    }
  ]
}
{% endschema %}
