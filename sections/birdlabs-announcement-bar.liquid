

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{%- assign birdlabs_marquee_direction = 'normal' -%}
{%- if section.settings.direction == 'right' -%}
  {%- assign birdlabs_marquee_direction = 'reverse' -%}
{%- endif -%}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}{% unless section.settings.enable_marquee %} birdlabs-marquee--static{% endunless %}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %} --birdlabs-marquee-speed: {{ section.settings.speed }}s; --birdlabs-marquee-direction: {{ birdlabs_marquee_direction }};"
>
  <div class="birdlabs-marquee">
    <div class="birdlabs-marquee__track">
      {% content_for 'blocks' %}
    </div>
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .birdlabs-marquee {
    overflow: hidden;
    width: 100%;
  }

  /*
    Horizon's ".section--page-width > *" rule (base.css) places this section's
    only child into the middle column of a 3-column layout grid, inset from the
    true screen edges by the page margin on both sides — confirmed live at a
    1440px viewport: .birdlabs-marquee sits at x=40 with 40px reserved on the
    right too, not edge-to-edge. For scrolling content that's the "truncated near
    the left rail" symptom: the marquee's own clipping boundary sits 40px+ inside
    the true edge, so text visibly disappears well before it reaches the actual
    side of the screen, on every pass, regardless of Direction. Forcing this
    element to span the section's full grid row (native Horizon's own
    ".section--full-width > *" pattern, just applied unconditionally here) gives
    the scroll its full, true edge-to-edge travel distance. Scoped to marquee mode
    only — static mode still honors the Section width setting, since a centered,
    non-moving line reads fine inset the way a normal page-width section does.
  */
  .announcement-bar:not(.birdlabs-marquee--static) > .birdlabs-marquee {
    grid-column: 1 / -1;
  }

  .birdlabs-marquee__track {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    animation-name: birdlabs-marquee-scroll;
    animation-duration: var(--birdlabs-marquee-speed, 5s);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: var(--birdlabs-marquee-direction, normal);
  }

  .birdlabs-marquee:hover .birdlabs-marquee__track {
    animation-play-state: paused;
  }

  /*
    Starts fully visible at rest (translateX(0)), holds there for the first 15% of
    the loop, then scrolls out to fully off-screen left. Previously this started at
    translateX(100%) — 100% of the TRACK'S OWN width, not the viewport's — which on
    narrow/mobile widths put the track's left edge close to or past the right edge
    of the screen at the very start of the loop, so nothing was visible for a
    stretch of each cycle before it scrolled into view. Starting at rest removes
    that dead time entirely: the announcement is readable immediately, then moves.
  */
  @keyframes birdlabs-marquee-scroll {
    0% {
      transform: translateX(0);
    }

    15% {
      transform: translateX(0);
    }

    100% {
      transform: translateX(-100%);
    }
  }

  /*
    Item-level display/wrap/typography rules live in
    blocks/birdlabs-announcement.liquid's own stylesheet — this section only owns
    the marquee track/animation and the between-item spacing.
  */
  .birdlabs-marquee__item:not(:last-child) {
    margin-inline-end: 3rem;
  }

  /*
    Static mode: freeze the track in place instead of animating it, and center the
    discount code in the bar regardless of how long pre-text/post-text are. The
    item becomes a 3-column grid (pre-text | discount-code | post-text) spanning
    the full bar width, with the discount code's column always in the middle.
    Pre-text is right-aligned toward the discount code, so if it's too long to fit
    it overflows/clips off the LEFT edge of the bar (the .birdlabs-marquee
    overflow:hidden ancestor does the clipping) instead of pushing the discount
    code off-center. This targets the single-announcement case — with more than
    one enabled block, each item would independently try to center itself across
    the full bar and overlap, which static mode doesn't attempt to solve.
  */
  .birdlabs-marquee--static .birdlabs-marquee__track {
    animation: none;
    transform: none;
    display: block;
    width: 100%;
  }

  .birdlabs-marquee--static .birdlabs-marquee__item {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    width: 100%;
    column-gap: 0.35em;
  }

  .birdlabs-marquee--static .birdlabs-marquee__pre-text {
    grid-column: 1;
    justify-self: end;
    text-align: right;
    margin-inline-end: 0;
    /* Grid tracks default to their content's min-content width, which for
       nowrap text is its full width — that blows the "1fr" sizing out and
       drags the discount code off-center. min-width: 0 + overflow: hidden let
       this column actually shrink to its 1fr share so the overflow spills past
       the bar's own edge (where it gets clipped) instead of past this column. */
    min-width: 0;
    overflow: hidden;
  }

  .birdlabs-marquee--static .birdlabs-marquee__discount-code {
    grid-column: 2;
    justify-self: center;
    margin-inline-end: 0;
  }

  .birdlabs-marquee--static .birdlabs-marquee__post-text {
    grid-column: 3;
    justify-self: start;
    min-width: 0;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .birdlabs-marquee__track {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BirdLabs — Announcement",
  "blocks": [
    {
      "type": "birdlabs-announcement"
    }
  ],
  "max_blocks": 3,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Marquee scrolling",
      "info": "Off = static, non-scrolling bar",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 1,
      "max": 30,
      "default": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.enable_marquee }}"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "info": "Also sets which side the pre-text leads from",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "BirdLabs — Announcement",
      "blocks": {
        "announcement_1": {
          "type": "birdlabs-announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
