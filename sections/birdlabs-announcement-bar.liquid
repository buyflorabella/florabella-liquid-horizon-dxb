

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{%- assign birdlabs_marquee_direction = 'normal' -%}
{%- if section.settings.direction == 'right' -%}
  {%- assign birdlabs_marquee_direction = 'reverse' -%}
{%- endif -%}

{%- comment -%}
  Task 0024: ported the native announcement bar's slideshow mechanism
  (announcement-bar-component + slideshow-arrows + assets/announcement-bar.js,
  all from sections/header-announcements.liquid) for non-marquee mode, and
  moved marquee mode onto a JS-driven delay-then-scroll cycle
  (assets/birdlabs-marquee.js) instead of a fixed keyframe hold. See
  claude_docs/tasks/0024_birdlabs_header_adjustments/0024_dd.md for the full
  writeup of why each of these changed.

  IMPORTANT: this file has exactly ONE content-for-blocks call (the theme-block
  insertion point), even though marquee vs. slideshow mode need different
  wrapper markup around it. A real Shopify save-time constraint, confirmed via
  a live FileSaveError naming a duplicate entry for that insertion point — the
  very first version
  of this fix had two calls, one per branch of an enable_marquee if/else,
  which never both execute but still counts as a duplicate at save time
  regardless of reachability. Both custom elements below are therefore
  always present; the mode difference is expressed as attributes/classes on
  them, not as separate branches around a repeated content_for call.
{%- endcomment -%}
{%- liquid
  assign is_marquee = section.settings.enable_marquee
  assign show_slideshow_controls = false
  if section.blocks.size > 1
    assign show_slideshow_controls = true
  endif
-%}

{% if is_marquee == false and show_slideshow_controls %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% if is_marquee %}
  <script
    src="{{ 'birdlabs-marquee.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %} --birdlabs-marquee-speed: {{ section.settings.speed }}s; --birdlabs-marquee-direction: {{ birdlabs_marquee_direction }}; --birdlabs-marquee-gap: {{ section.settings.gap_between_elements }}px;"
>
  <birdlabs-marquee{% if is_marquee %} delay="{{ section.settings.delay }}"{% endif %}>
    <announcement-bar-component
      class="birdlabs-announcement-bar__slider"
      {% if is_marquee == false and show_slideshow_controls %}
        autoplay="{{ section.settings.slide_interval }}" aria-live="polite"
      {% endif %}
    >
      {% if is_marquee == false and show_slideshow_controls %}
        {% render 'slideshow-arrows', icon_style: 'chevron' %}
      {% endif %}

      <div class="birdlabs-announcement-bar__slides">
        {% content_for 'blocks' %}
      </div>
    </announcement-bar-component>
  </birdlabs-marquee>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  birdlabs-marquee {
    display: block;
    overflow: hidden;
    width: 100%;
  }

  /*
    Horizon's ".section--page-width > *" rule (base.css) places this section's
    only child into the middle column of a 3-column layout grid, inset from the
    true screen edges by the page margin on both sides — confirmed live at a
    1440px viewport: the marquee sat at x=40 with 40px reserved on the right
    too, not edge-to-edge. Forcing this element to span the section's full
    grid row (native Horizon's own ".section--full-width > *" pattern, just
    applied unconditionally here) gives it the true, full viewport width in
    both marquee and slideshow mode. <birdlabs-marquee> is always the direct
    child of .announcement-bar now (see the markup note above about why both
    custom elements are unconditional), so this one selector covers both modes.
  */
  .announcement-bar > birdlabs-marquee {
    grid-column: 1 / -1;
  }

  /*
    .birdlabs-announcement-bar__slider (announcement-bar-component) and
    .birdlabs-announcement-bar__slides (the shared blocks container) are
    shared by both modes — task 0024 ported the slideshow layout in as the
    base/default, and marquee mode overrides it via the --marquee and
    --scrolling modifier classes below (added by assets/birdlabs-marquee.js),
    rather than two separate DOM structures — see the markup note above for
    why (Shopify only allows one theme-block insertion point per file).
  */
  .birdlabs-announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .birdlabs-announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .birdlabs-announcement-bar__slides > * {
    grid-area: stack;
  }

  /*
    Task 0024 fix: the old marquee track was `display: block`, and
    blocks/birdlabs-announcement.liquid's .birdlabs-marquee__item is
    `display: grid` — which forces a block-level box regardless of the
    underlying <span>/<a> tag, so multiple announcements stacked as separate
    rows instead of sitting side by side. This modifier (added by JS only
    when section.settings.enable_marquee is on) switches the shared slides
    container to a flex row instead: once it's a flex container, each item's
    own outer display no longer matters for sibling layout — flex children
    always lay out in a row. `gap` is the new "space between announcements"
    setting (section.settings.gap_between_elements), ported from native
    blocks/_marquee.liquid's identical pattern. `grid-template-columns: none`
    /`max-width: none` undo the slideshow-mode grid-stack/680px constraints
    above, which don't apply once this is a horizontally-scrolling row.
  */
  .birdlabs-announcement-bar__slides--marquee {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    max-width: none;
    margin-inline: 0;
    white-space: nowrap;
    gap: var(--birdlabs-marquee-gap, 0px);
    transform: translateX(0);
  }

  .birdlabs-announcement-bar__slides--marquee > * {
    grid-area: unset;
  }

  /*
    Task 0024: delay-before-scroll is now driven by JS (assets/birdlabs-marquee.js),
    not baked into a keyframe as a fixed hold percentage. A merchant-adjustable
    "Delay before scroll" (real seconds, independent of scroll speed) can't be
    expressed as a keyframe percentage — keyframe stops are static CSS, and
    Shopify stylesheet blocks don't accept Liquid-templated values in them (see
    .claude/CLAUDE.md). The track sits at rest (rule above) until JS adds
    --scrolling below, which plays a single scroll pass
    (animation-iteration-count: 1, not infinite — JS needs the animationend
    event to fire so it can reschedule the next delay+scroll cycle).
  */
  .birdlabs-announcement-bar__slides--scrolling {
    animation-name: birdlabs-marquee-scroll;
    animation-duration: var(--birdlabs-marquee-speed, 5s);
    animation-timing-function: linear;
    animation-iteration-count: 1;
    animation-direction: var(--birdlabs-marquee-direction, normal);
  }

  birdlabs-marquee:hover .birdlabs-announcement-bar__slides--scrolling {
    animation-play-state: paused;
  }

  @keyframes birdlabs-marquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .birdlabs-announcement-bar__slides--scrolling {
      animation: none;
    }
  }

  .birdlabs-announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .birdlabs-announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;
  }

  @media screen and (min-width: 750px) {
    .birdlabs-announcement-bar__slider .slideshow-control {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);
    }

    .section--page-width .birdlabs-announcement-bar__slider .slideshow-control--previous {
      transform: translateX(var(--slideshow-control-offset));
    }
  }

  .birdlabs-announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BirdLabs — Announcement",
  "blocks": [
    {
      "type": "birdlabs-announcement"
    }
  ],
  "max_blocks": 3,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Marquee scrolling",
      "info": "Off = slideshow bar with arrows, like the native announcement bar",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 1,
      "max": 30,
      "default": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.enable_marquee }}"
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Delay before scroll",
      "info": "Pause at rest before each scroll pass begins",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 1,
      "unit": "sec",
      "visible_if": "{{ section.settings.enable_marquee }}"
    },
    {
      "type": "range",
      "id": "gap_between_elements",
      "label": "Gap between announcements",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_marquee }}"
    },
    {
      "type": "range",
      "id": "slide_interval",
      "label": "Time to next announcement",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.enable_marquee == false }}"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "info": "Also sets which side the pre-text leads from",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "BirdLabs — Announcement",
      "blocks": {
        "announcement_1": {
          "type": "birdlabs-announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
