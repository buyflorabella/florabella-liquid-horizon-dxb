

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{%- assign birdlabs_marquee_direction = 'normal' -%}
{%- if section.settings.direction == 'right' -%}
  {%- assign birdlabs_marquee_direction = 'reverse' -%}
{%- endif -%}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}{% unless section.settings.enable_marquee %} birdlabs-marquee--static{% endunless %}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %} --birdlabs-marquee-speed: {{ section.settings.speed }}s; --birdlabs-marquee-direction: {{ birdlabs_marquee_direction }};"
>
  <div class="birdlabs-marquee">
    <div class="birdlabs-marquee__track">
      {% content_for 'blocks' %}
    </div>
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .birdlabs-marquee {
    overflow: hidden;
    width: 100%;
  }

  /*
    Horizon's ".section--page-width > *" rule (base.css) places this section's
    only child into the middle column of a 3-column layout grid, inset from the
    true screen edges by the page margin on both sides — confirmed live at a
    1440px viewport: .birdlabs-marquee sat at x=40 with 40px reserved on the
    right too, not edge-to-edge. Forcing this element to span the section's full
    grid row (native Horizon's own ".section--full-width > *" pattern, just
    applied unconditionally here) gives it the true, full viewport width.
    Unconditional now (both marquee and static mode) because centering the
    discount code on the actual screen center — not the page-width column's
    center — needs the full width either way. Net effect: the "Section width"
    setting (page-width vs. full-width) no longer visibly changes anything for
    this section; flag it to DXB if that setting should just be removed.
  */
  .announcement-bar > .birdlabs-marquee {
    grid-column: 1 / -1;
  }

  .birdlabs-marquee__track {
    display: block;
    width: 100%;
    white-space: nowrap;
    animation-name: birdlabs-marquee-scroll;
    animation-duration: var(--birdlabs-marquee-speed, 5s);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: var(--birdlabs-marquee-direction, normal);
  }

  .birdlabs-marquee:hover .birdlabs-marquee__track {
    animation-play-state: paused;
  }

  /*
    Starts fully visible at rest (translateX(0)), holds there for the first 15% of
    the loop, then scrolls out to fully off-screen left. Previously this started at
    translateX(100%) — 100% of the TRACK'S OWN width, not the viewport's — which on
    narrow/mobile widths put the track's left edge close to or past the right edge
    of the screen at the very start of the loop, so nothing was visible for a
    stretch of each cycle before it scrolled into view. Starting at rest removes
    that dead time entirely: the announcement is readable immediately, then moves.
  */
  @keyframes birdlabs-marquee-scroll {
    0% {
      transform: translateX(0);
    }

    15% {
      transform: translateX(0);
    }

    100% {
      transform: translateX(-100%);
    }
  }

  /*
    Item-level grid/typography/color rules (the pre-text | discount-code |
    post-text layout that centers the discount code) live in
    blocks/birdlabs-announcement.liquid's own stylesheet — that same layout is
    now used in both marquee and static mode, so this section only needs to
    stop the track's animation for static mode.
  */
  .birdlabs-marquee--static .birdlabs-marquee__track {
    animation: none;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .birdlabs-marquee__track {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BirdLabs — Announcement",
  "blocks": [
    {
      "type": "birdlabs-announcement"
    }
  ],
  "max_blocks": 3,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Marquee scrolling",
      "info": "Off = static, non-scrolling bar",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 1,
      "max": 30,
      "default": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.enable_marquee }}"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "info": "Also sets which side the pre-text leads from",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "BirdLabs — Announcement",
      "blocks": {
        "announcement_1": {
          "type": "birdlabs-announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
