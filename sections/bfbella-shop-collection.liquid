<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }

  document.addEventListener('click', (event) => {
    const buyNowButton = event.target instanceof Element
      ? event.target.closest('[data-bfbella-buy-now]')
      : null;
    if (buyNowButton) {
      window.__bfbellaBuyNowArmed = true;
    }
  });

  import('@shopify/events').then(({ StandardEvents }) => {
    document.addEventListener(StandardEvents.cartLinesUpdate, (cartEvent) => {
      if (window.__bfbellaBuyNowArmed && cartEvent.action === 'add') {
        window.__bfbellaBuyNowArmed = false;
        const drawer = document.getElementById('cart-drawer');
        if (drawer && typeof drawer.open === 'function') {
          drawer.open();
        }
      }
    });
  });
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

{% style %}
  @media screen and (min-width: 750px) {
    .product-grid--{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.max_columns | default: 3 }}, 1fr) !important;
    }
  }
{% endstyle %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
{% # theme-check-disable-next-line UnknownFilter %}
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list
    class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    {% if section.settings.show_category_filter %}
      <div
        class="bfbella-shop-tabs bfbella-shop-tabs--{{ section.settings.tabs_alignment | default: 'left' }}"
        style="
          --bfbella-shop-accent: {{ section.settings.accent_color | default: settings.color_palette.color1 }};
          {% if section.settings.tab_text_color != blank %}--bfbella-shop-tab-text: {{ section.settings.tab_text_color }};{% endif %}
          {% if section.settings.tab_active_text_color != blank %}--bfbella-shop-tab-active-text: {{ section.settings.tab_active_text_color }};{% endif %}
        "
      >
        {% if section.settings.all_products_collection != blank %}
          <a
            href="{{ section.settings.all_products_collection.url }}"
            class="bfbella-shop-tab{% if collection.handle == section.settings.all_products_collection.handle %} bfbella-shop-tab--active{% endif %}"
            {% if collection.handle == section.settings.all_products_collection.handle %}aria-current="page"{% endif %}
          >
            {{ section.settings.all_label | default: 'All' }}
          </a>
        {% endif %}
        {% if section.settings.category_1_collection != blank %}
          <a
            href="{{ section.settings.category_1_collection.url }}"
            class="bfbella-shop-tab{% if collection.handle == section.settings.category_1_collection.handle %} bfbella-shop-tab--active{% endif %}"
            {% if collection.handle == section.settings.category_1_collection.handle %}aria-current="page"{% endif %}
          >
            {{ section.settings.category_1_label | default: section.settings.category_1_collection.title }}
          </a>
        {% endif %}
        {% if section.settings.category_2_collection != blank %}
          <a
            href="{{ section.settings.category_2_collection.url }}"
            class="bfbella-shop-tab{% if collection.handle == section.settings.category_2_collection.handle %} bfbella-shop-tab--active{% endif %}"
            {% if collection.handle == section.settings.category_2_collection.handle %}aria-current="page"{% endif %}
          >
            {{ section.settings.category_2_label | default: section.settings.category_2_collection.title }}
          </a>
        {% endif %}
        {% if section.settings.category_3_collection != blank %}
          <a
            href="{{ section.settings.category_3_collection.url }}"
            class="bfbella-shop-tab{% if collection.handle == section.settings.category_3_collection.handle %} bfbella-shop-tab--active{% endif %}"
            {% if collection.handle == section.settings.category_3_collection.handle %}aria-current="page"{% endif %}
          >
            {{ section.settings.category_3_label | default: section.settings.category_3_collection.title }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div
      id="bfbella-shop-grid-{{ section.id }}"
      class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {% assign products_per_page = 24 %}

      {% if section.settings.enable_infinite_scroll == false %}
        {% assign products_per_page = section.settings.products_per_page %}
      {% endif %}

      {% paginate collection.products by products_per_page %}
        {% capture children %}
          {% for product in collection.products %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              ref="cards[]"
            >
              {% render 'bfbella-shop-product-card', product: product, section: section %}
            </li>
          {% endfor %}
        {% endcapture %}

        {% render 'product-grid',
          section: section,
          children: children,
          products: collection.products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll
        %}
      {% endpaginate %}
    </div>
  </results-list>
</collection-component>

{% stylesheet %}
  .bfbella-shop-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 1.5rem;
    -webkit-overflow-scrolling: touch;
  }

  .bfbella-shop-tabs--left {
    justify-content: flex-start;
  }

  .bfbella-shop-tabs--center {
    justify-content: center;
  }

  .bfbella-shop-tabs--right {
    justify-content: flex-end;
  }

  .bfbella-shop-tab {
    display: inline-block;
    border: 1px solid rgb(var(--color-border-rgb) / 0.4);
    background: transparent;
    border-radius: 8px;
    padding: 0.5rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--bfbella-shop-tab-text, rgb(var(--color-foreground)));
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .bfbella-shop-tab:hover {
    border-color: var(--bfbella-shop-accent);
  }

  .bfbella-shop-tab--active {
    border-color: var(--bfbella-shop-accent);
    background: var(--bfbella-shop-accent);
    color: var(--bfbella-shop-tab-active-text, rgb(var(--color-background)));
  }

  @media screen and (max-width: 749px) {
    .bfbella-shop-tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-block-end: 0.25rem;
    }
  }

  .bfbella-shop-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bfbella-card-bg);
    border: 1px solid rgb(var(--color-border-rgb) / 0.4);
    border-radius: var(--bfbella-card-radius);
    overflow: hidden;
  }

  .bfbella-shop-card__media {
    display: block;
    position: relative;
  }

  .bfbella-shop-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .bfbella-shop-card__badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: var(--bfbella-shop-accent, rgb(var(--color-foreground)));
    color: rgb(var(--color-background));
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .bfbella-shop-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    flex-grow: 1;
    color: var(--bfbella-card-text, rgb(var(--color-foreground)));
  }

  .bfbella-shop-card__title {
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
    color: inherit;
  }

  .bfbella-shop-card__excerpt {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bfbella-shop-card__price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .bfbella-shop-card__compare-price {
    font-size: 0.95rem;
    font-weight: 400;
    opacity: 0.5;
  }

  .bfbella-shop-card__actions {
    display: flex;
    gap: 0.5rem;
    margin-block-start: 0.25rem;
  }

  .bfbella-shop-card__actions > * {
    flex: 1;
  }

  .bfbella-shop-card__add-form {
    display: block;
    width: 100%;
  }

  .bfbella-shop-card__add-button.bfbella-shop-card__add-button {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
  }

  .bfbella-shop-card__add-icon svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .bfbella-shop-card__buynow-form {
    display: block;
    width: 100%;
  }

  .bfbella-shop-card__buynow-button.bfbella-shop-card__buynow-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: transparent;
    color: rgb(var(--color-foreground));
    border: 1px solid rgb(var(--color-border-rgb) / 0.6);
    border-radius: 4px;
  }

  .bfbella-shop-card__view-details {
    display: block;
    text-align: center;
    margin-block-start: 0.5rem;
    padding: 0.65rem 1rem;
    border: 1px solid rgb(var(--color-border-rgb) / 0.4);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    font-weight: 600;
    font-size: 0.9rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BFBella — Shop Collection",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Category navigation (tabs)"
    },
    {
      "type": "paragraph",
      "content": "Links between real collections — not a client-side filter. Each collection below should already contain the right products; this just draws a consistent tab bar linking them together."
    },
    {
      "type": "checkbox",
      "id": "show_category_filter",
      "label": "Show category navigation tabs",
      "default": true
    },
    {
      "type": "collection",
      "id": "all_products_collection",
      "label": "\"All\" tab — collection"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "\"All\" tab — label",
      "default": "All"
    },
    {
      "type": "collection",
      "id": "category_1_collection",
      "label": "Category 1 — collection"
    },
    {
      "type": "text",
      "id": "category_1_label",
      "label": "Category 1 — label override (optional)"
    },
    {
      "type": "collection",
      "id": "category_2_collection",
      "label": "Category 2 — collection"
    },
    {
      "type": "text",
      "id": "category_2_label",
      "label": "Category 2 — label override (optional)"
    },
    {
      "type": "collection",
      "id": "category_3_collection",
      "label": "Category 3 — collection"
    },
    {
      "type": "text",
      "id": "category_3_label",
      "label": "Category 3 — label override (optional)"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Active tab color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab text color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "tab_active_text_color",
      "label": "Active tab text color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "tabs_alignment",
      "label": "Tabs alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "range",
      "id": "max_columns",
      "label": "Max columns (desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "BFBella — Shop Collection"
    }
  ]
}
{% endschema %}
