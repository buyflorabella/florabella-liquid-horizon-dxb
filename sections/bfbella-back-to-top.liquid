<button
  class="bfbella-back-to-top"
  aria-label="Back to top"
  type="button"
  data-scroll-to-top
>
  <svg
    aria-hidden="true"
    focusable="false"
    class="bfbella-back-to-top__icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

{% stylesheet %}
  .bfbella-back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border: none;
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    padding: 0;
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 100;
    transition: opacity 0.3s ease;
  }

  .bfbella-back-to-top:hover {
    opacity: 0.8;
  }

  .bfbella-back-to-top.is-visible {
    display: flex;
  }

  .bfbella-back-to-top__icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (max-width: 768px) {
    .bfbella-back-to-top {
      bottom: 1rem;
      right: 1rem;
      width: 2.5rem;
      height: 2.5rem;
    }

    .bfbella-back-to-top__icon {
      width: 1.25rem;
      height: 1.25rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    const button = document.querySelector('[data-scroll-to-top]');
    if (!button) return;

    // This theme scrolls on window/body at narrow widths, but at >=990px
    // html/body get overflow: hidden and .page-wrapper becomes the real
    // scrollable element instead (see assets/base.css). Must check/act on
    // both, since which one is actually scrolling depends on viewport width.
    function getScrollPosition() {
      const wrapper = document.querySelector('.page-wrapper');
      if (wrapper && wrapper.scrollTop > 0) {
        return wrapper.scrollTop;
      }
      return window.scrollY;
    }

    function toggleButtonVisibility() {
      if (getScrollPosition() > 300) {
        button.classList.add('is-visible');
      } else {
        button.classList.remove('is-visible');
      }
    }

    button.addEventListener('click', function() {
      const wrapper = document.querySelector('.page-wrapper');
      if (wrapper) {
        wrapper.scrollTo({ top: 0, behavior: 'smooth' });
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    window.addEventListener('scroll', toggleButtonVisibility, { passive: true });
    document.querySelector('.page-wrapper')?.addEventListener('scroll', toggleButtonVisibility, { passive: true });
    toggleButtonVisibility();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "BFBella — Back to Top"
}
{% endschema %}
