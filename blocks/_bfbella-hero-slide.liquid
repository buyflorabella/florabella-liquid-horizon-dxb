{%- comment -%}
  BFBella — Hero Slide (task 0027). One image in the hero's image slideshow.
  Private block: only addable inside the BFBella hero slideshow block. Renders its own slide
  element, the same way Horizon's native carousel cards do (ref="slides[]" is what the native
  slideshow script looks for). A nested block cannot know its own position among its siblings,
  so the parent slideshow block sets each slide's dot-tracking timeline name with nth-child rules.
{%- endcomment -%}

{%- liquid
  assign widths = '416, 600, 832, 1200, 1600, 1920, 2560'
  if section.settings.split_layout
    assign sizes = '(min-width: 750px) 50vw, 100vw'
  else
    assign sizes = '100vw'
  endif

  assign loading = 'lazy'
  if section.index <= 2
    assign loading = 'eager'
  endif
-%}

<slideshow-slide
  ref="slides[]"
  class="bfbella-hero-slide"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.image != blank -%}
    {{
      block.settings.image
      | image_url: width: 2560
      | image_tag:
        widths: widths,
        sizes: sizes,
        loading: loading,
        class: 'hero__media bfbella-hero-slide__image'
    }}
  {%- else -%}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__media bfbella-hero-slide__image' }}
  {%- endif -%}
</slideshow-slide>

{% schema %}
{
  "name": "BFBella — Hero Slide",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    }
  ],
  "presets": [
    {
      "name": "BFBella — Hero Slide"
    }
  ]
}
{% endschema %}
