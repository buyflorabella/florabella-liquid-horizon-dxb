{% comment %}
  BFBella — Community Card

  Renders one card in "A Community For Growers Who Care About Soil Health": an icon badge,
  heading, description, and then either a native Shopify email-capture form or a link button,
  depending on "Card type."

  ONE block type covering both card kinds (rather than two separate block types) is deliberate —
  this section only ever needs two blocks in one location, so there's no need to split locations
  the way Task 5 had to; a single self-branching block keeps this simple. See
  .claude/CLAUDE.md's "Theme Blocks Must Render Themselves" section for why it renders itself
  either way rather than the parent reading its settings.

  EMAIL CAPTURE: production used an Omnisend embedded form (Hydrogen-era decision — DXB:
  "we *were* going to use omnisend for e-mail capture because we had hydrogen"). Refactored to
  Shopify's own native customer-signup form instead (`{% form 'customer' %}` with
  `contact[email]`) per DXB's explicit ask — this is the exact same mechanism this theme's own
  native `blocks/email-signup.liquid` uses (confirmed by reading it), just styled to match this
  card's look instead of that block's own layout. Submissions create a real Shopify customer
  record and show Shopify's native success/error state — no third-party service, no API key.

  GROWERS GROUP LINK: a `url` setting (Shopify's native link picker — pages, blogs, products, or
  a plain external URL), not a hardcoded path, so DXB can point it at the Community page (or
  anywhere else) and change it later without touching code. Production's WhatsApp-group A/B
  branch is Hydrogen-specific plumbing (a feature flag + env var) with no direct Shopify
  equivalent and wasn't part of what DXB asked for — this card is the simple, static version:
  one link, one button.

  DEPLOY: save as blocks/bfbella-community-card.liquid in the live theme.
{% endcomment %}

<div class="bfbella-community-card" {{ block.shopify_attributes }}>
  <div class="bfbella-community-card__icon">
    {%- if block.settings.card_type == 'growers_group' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
    {%- endif -%}
  </div>

  {%- if block.settings.heading != blank -%}
    <h3 class="bfbella-community-card__heading">{{ block.settings.heading }}</h3>
  {%- endif -%}
  {%- if block.settings.description != blank -%}
    <p class="bfbella-community-card__description">{{ block.settings.description }}</p>
  {%- endif -%}

  {%- if block.settings.card_type == 'growers_group' -%}
    {%- if block.settings.link != blank -%}
      <a href="{{ block.settings.link }}" class="bfbella-community-card__button bfbella-community-card__button--secondary">
        {{ block.settings.link_text | default: 'Request invite' }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12,5 19,12 12,19"/>
        </svg>
      </a>
    {%- endif -%}
  {%- else -%}
    {%- form 'customer', class: 'bfbella-community-card__form' -%}
      <label for="BfbellaEmail-{{ block.id }}" class="visually-hidden">{{ 'blocks.email_signup.label' | t }}</label>
      <input
        id="BfbellaEmail-{{ block.id }}"
        type="email"
        name="contact[email]"
        autocorrect="off"
        autocapitalize="off"
        autocomplete="email"
        placeholder="Your email address"
        required
        class="bfbella-community-card__input"
        {%- if form.errors -%}
          autofocus
          aria-invalid="true"
          aria-describedby="BfbellaEmailError-{{ block.id }}"
        {%- endif -%}
      >
      <button type="submit" class="bfbella-community-card__button">
        {{ block.settings.button_label | default: 'Get soil tips' }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12,5 19,12 12,19"/>
        </svg>
      </button>

      {%- if form.errors -%}
        <p id="BfbellaEmailError-{{ block.id }}" class="bfbella-community-card__message bfbella-community-card__message--error">
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        </p>
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <p class="bfbella-community-card__message bfbella-community-card__message--success">
          {{ 'blocks.email_signup.success' | t }}
        </p>
      {%- endif -%}
    {%- endform -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .bfbella-community-card {
    background-color: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 1.5rem;
    padding: 2rem;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.08);
    transition: transform 0.3s;
  }

  .bfbella-community-card:hover {
    transform: scale(1.03);
  }

  .bfbella-community-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--bfbella-accent) 20%, transparent);
    color: var(--bfbella-accent);
    margin-block-end: 1.5rem;
  }

  .bfbella-community-card__icon svg {
    width: 2rem;
    height: 2rem;
  }

  .bfbella-community-card__heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin-block-end: 1rem;
  }

  .bfbella-community-card__description {
    opacity: 0.7;
    line-height: 1.5;
    margin-block-end: 1.5rem;
  }

  .bfbella-community-card__form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bfbella-community-card__input {
    width: 100%;
    background-color: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    color: var(--color-foreground);
    font-size: 1rem;
  }

  .bfbella-community-card__input:focus {
    outline: none;
    border-color: var(--bfbella-accent);
  }

  .bfbella-community-card__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.85rem 1.5rem;
    border-radius: 0.75rem;
    font-weight: 700;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    background-color: var(--bfbella-accent);
    color: #fff;
    transition: transform 0.2s;
    text-decoration: none;
  }

  .bfbella-community-card__button:hover {
    transform: scale(1.03);
  }

  .bfbella-community-card__button svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .bfbella-community-card__button--secondary {
    background-color: rgb(var(--color-foreground-rgb) / 0.08);
    color: var(--color-foreground);
    border: 2px solid rgb(var(--color-foreground-rgb) / 0.15);
  }

  .bfbella-community-card__message {
    font-size: 0.85rem;
    margin: 0;
  }

  .bfbella-community-card__message--error {
    color: #d64545;
  }

  .bfbella-community-card__message--success {
    color: var(--bfbella-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .bfbella-community-card,
    .bfbella-community-card__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BFBella — Community Card",
  "settings": [
    {
      "type": "select",
      "id": "card_type",
      "label": "Card type",
      "options": [
        { "value": "email", "label": "Email signup (native Shopify form)" },
        { "value": "growers_group", "label": "Growers group (link button)" }
      ],
      "default": "email"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Email signup button text",
      "default": "Get soil tips",
      "info": "Only used when Card type is Email signup.",
      "visible_if": "{{ block.settings.card_type == 'email' }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Point at the Community page, or anywhere else — a Shopify page, blog, product, or external URL. Only used when Card type is Growers group.",
      "visible_if": "{{ block.settings.card_type == 'growers_group' }}"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link button text",
      "default": "Request invite",
      "info": "Only used when Card type is Growers group.",
      "visible_if": "{{ block.settings.card_type == 'growers_group' }}"
    }
  ]
}
{% endschema %}
