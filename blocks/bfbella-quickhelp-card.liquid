{% comment %}
  BFBella — Quickhelp Card

  Renders one card in the Contact page's Quick Help grid (Order Help / Product Questions /
  Partnerships / Location). Heading + text + an optional link — Location has no link, just an
  icon + address text, matching production (Partnerships also has no link in production).

  Built as a genuine theme block from the start (renders itself entirely; the parent section
  only does `{% content_for 'blocks' %}`) — see .claude/CLAUDE.md's "Theme Blocks Must Render
  Themselves" section.

  ICON: map_pin, only shown for the Location card — reused verbatim from the theme's own native
  icon set is not applicable here since this block predates that reuse pattern being needed;
  hand-drawn to match lucide's published shape, not rendered standalone to visually confirm
  since this session has no browser/preview access.

  DEPLOY: written directly into this live repo's working tree as part of the 2026-09-07
  live-edit pilot (see claude_docs/build_docs/live_edit_pilot_plan.md) — DXB reviews, then
  commits and pushes by hand.
{% endcomment %}

<div class="bfbella-quickhelp-card" {{ block.shopify_attributes }}>
  {%- if block.settings.icon == 'map_pin' -%}
    <div class="bfbella-quickhelp-card__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
    </div>
  {%- endif -%}

  {%- if block.settings.heading != blank -%}
    <h3 class="bfbella-quickhelp-card__heading">{{ block.settings.heading }}</h3>
  {%- endif -%}
  {%- if block.settings.text != blank -%}
    <p class="bfbella-quickhelp-card__text">{{ block.settings.text | newline_to_br }}</p>
  {%- endif -%}
  {%- if block.settings.link_label != blank -%}
    <a
      {% if block.settings.link_url != blank %}href="{{ block.settings.link_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
      class="bfbella-quickhelp-card__link"
    >
      {{ block.settings.link_label }}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12,5 19,12 12,19"/>
      </svg>
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .bfbella-quickhelp-card {
    background: rgb(255 255 255 / 0.03);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 1.25rem;
    padding: 1.5rem;
  }

  .bfbella-quickhelp-card__icon {
    display: inline-flex;
    color: var(--bfbella-accent);
    margin-block-end: 0.75rem;
  }

  .bfbella-quickhelp-card__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .bfbella-quickhelp-card__heading {
    font-size: 1.15rem;
    font-weight: 700;
    margin-block-end: 0.75rem;
  }

  .bfbella-quickhelp-card__text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.7);
    margin-block-end: 0.75rem;
  }

  .bfbella-quickhelp-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--bfbella-accent);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .bfbella-quickhelp-card__link:hover {
    text-decoration: underline;
  }

  .bfbella-quickhelp-card__link svg {
    width: 0.9rem;
    height: 0.9rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BFBella — Quickhelp Card",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "map_pin", "label": "Map pin" }
      ],
      "default": "none",
      "info": "Only Location typically needs an icon here."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "For Location, put the full address here (line breaks preserved)."
    },
    {
      "type": "header",
      "content": "Optional link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "Leave blank for no link (Partnerships and Location have none in production)."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ]
}
{% endschema %}
