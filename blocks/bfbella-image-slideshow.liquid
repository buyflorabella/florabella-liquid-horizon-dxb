{%- comment -%}
  BFBella — Image Slideshow (task 0027). A theme block that can go anywhere a native Image block
  can (any section or group that accepts theme blocks) and shows one or more images as a slider.
  Same shape as Horizon's native carousel: repeatable child blocks handed to the shared slideshow
  snippet and script. Auto-rotate, pagination and arrow settings are copied from the native
  Slideshow section; aspect ratio and corner radius mirror the native Image block.
  - 0 slides: renders nothing on the storefront.
  - 1 slide: a still image, no arrows or dots.
  - 2+ slides: a slider.
{%- endcomment -%}

{%- liquid
  assign slide_count = block.blocks.size

  case block.settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    else
      assign ratio = '1'
  endcase

  assign show_arrows = false
  if block.settings.icons_style != 'none' and slide_count > 1
    assign show_arrows = true
  endif

  assign autoplay = false
  if block.settings.autoplay and slide_count > 1
    assign autoplay = true
  endif

  assign slideshow_class = 'bfbella-image-slideshow__component'
  if slide_count == 1
    assign slideshow_class = slideshow_class | append: ' slideshow--single-media'
  endif
-%}

{%- if slide_count > 0 -%}
  {%- if slide_count > 1 and block.settings.slideshow_controls_style != 'none' -%}
    {% capture controls %}
      {%- render 'slideshow-controls',
        style: block.settings.slideshow_controls_style,
        autoplay: autoplay,
        item_count: slide_count,
        show_arrows: false,
        arrows_on_media: true,
        controls_on_media: true,
        pagination_position: 'center',
        icon_style: block.settings.icons_style
      -%}
    {% endcapture %}
  {%- endif -%}

  {% capture slides %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% style %}
    {%- for i in (1..slide_count) -%}
      #BfbImageSlideshow-{{ block.id }} slideshow-slide:nth-child({{ i }}) {
        --slideshow-timeline: --slide-{{ i | minus: 1 }};
      }
    {%- endfor -%}
  {% endstyle %}

  <div
    id="BfbImageSlideshow-{{ block.id }}"
    class="bfbella-image-slideshow"
    style="--bfbella-slideshow-ratio: {{ ratio }}; --bfbella-slideshow-radius: {{ block.settings.border_radius }}px;"
    {{ block.shopify_attributes }}
  >
    {% render 'slideshow',
      class: slideshow_class,
      controls: controls,
      show_arrows: show_arrows,
      icon_style: block.settings.icons_style,
      icon_shape: block.settings.icons_shape,
      autoplay: autoplay,
      autoplay_speed: block.settings.autoplay_speed,
      slides: slides,
      slide_count: slide_count
    %}
  </div>
{%- endif -%}

{% stylesheet %}
  .bfbella-image-slideshow {
    width: 100%;
    aspect-ratio: var(--bfbella-slideshow-ratio, 1);
    border-radius: var(--bfbella-slideshow-radius, 0);
    overflow: hidden;
  }

  .bfbella-image-slideshow slideshow-component {
    height: 100%;
  }

  .bfbella-image-slideshow slideshow-container {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  .bfbella-image-slideshow slideshow-slides,
  .bfbella-image-slideshow slideshow-slide {
    height: 100%;
  }

  .bfbella-image-slide__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* First slide paints before the slideshow script has stamped aria-hidden on it. */
  .bfbella-image-slideshow slideshow-slide:first-child:not([aria-hidden]) {
    content-visibility: visible;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BFBella — Image Slideshow",
  "tag": null,
  "blocks": [
    {
      "type": "_bfbella-image-slide"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Add one slide per image. One slide shows a still image; two or more become a slider."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:settings.auto_rotate_slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:settings.speed",
      "min": 3,
      "max": 7,
      "step": 1,
      "unit": "s",
      "default": 4,
      "visible_if": "{{ block.settings.autoplay }}"
    },
    {
      "type": "select",
      "id": "slideshow_controls_style",
      "label": "t:settings.pagination",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "counter",
          "label": "t:options.counter"
        }
      ],
      "default": "dots"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icons",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.large_arrows"
        },
        {
          "value": "chevron_large",
          "label": "t:options.large_chevrons"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrows_large"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.icons_style != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "BFBella — Image Slideshow"
    }
  ]
}
{% endschema %}
