{% comment %}
  BFBella — Analysis Row

  Renders one row (element name, symbol, percentage) inside the Guaranteed Analysis panel.

  2026-09-07 — rebuilt from a "pure data block" (rendered nothing, parent read its settings
  directly) to a self-rendering block, same fix as every other block in this task series —
  see .claude/CLAUDE.md's "Theme Blocks Must Render Themselves" section.

  DEPLOY: save as blocks/bfbella-analysis-row.liquid in the live theme.
{% endcomment %}

<div class="bfbella-analysis__row" {{ block.shopify_attributes }}>
  <span class="bfbella-analysis__row-left">
    <span class="bfbella-analysis__row-symbol">{{ block.settings.symbol }}</span>
    <span class="bfbella-analysis__row-element">{{ block.settings.element }}</span>
  </span>
  <span class="bfbella-analysis__row-percentage">{{ block.settings.percentage }}</span>
</div>

{% schema %}
{
  "name": "BFBella — Analysis Row",
  "settings": [
    {
      "type": "text",
      "id": "element",
      "label": "Element name",
      "info": "e.g. Calcium"
    },
    {
      "type": "text",
      "id": "symbol",
      "label": "Symbol",
      "info": "e.g. Ca"
    },
    {
      "type": "text",
      "id": "percentage",
      "label": "Percentage",
      "info": "e.g. 1.40%"
    }
  ]
}
{% endschema %}
