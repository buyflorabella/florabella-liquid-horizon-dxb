

{% render 'text-block-styles' %}

{%- comment -%}
  Renders text-block-styles for its .custom-color rule (used by the color pickers
  below), but this item deliberately never carries the "text-block" class itself —
  see the note in the stylesheet block further down for why.
{%- endcomment -%}

{%- assign block_settings = block.settings -%}
{%- assign plain_pre = block_settings.pre_text | strip_newlines | strip_html | strip -%}
{%- assign plain_post = block_settings.post_text | strip_newlines | strip_html | strip -%}
{%- assign discount_code = block_settings.discount_code | strip -%}

{%- comment -%}
  Task 0024: this block now renders two different ways depending on
  section.settings.enable_marquee — a plain flex-row item in marquee mode, or
  a slideshow-slide (native slider mechanism, ported from
  sections/header-announcements.liquid) in non-marquee mode. Blocks can read
  `section` from inside their own file, so this switch lives entirely here —
  no variable is being passed down from the parent (not supported for theme
  blocks; see .claude/CLAUDE.md's "Theme Blocks Must Render Themselves").
{%- endcomment -%}
{%- assign is_marquee = section.settings.enable_marquee -%}
{%- assign item_tag = 'span' -%}
{%- if is_marquee and block_settings.link != blank -%}
  {%- assign item_tag = 'a' -%}
{%- endif -%}

{%- assign block_index = section.blocks | find_index: 'id', block.id -%}

{%- unless plain_pre == '' and discount_code == '' and plain_post == '' -%}
  {%- if is_marquee -%}
    <{{ item_tag }}
      class="
        birdlabs-marquee__item
        custom-typography
        {% if block_settings.font_size != "" %}custom-font-size{% endif %}
        {% if block_settings.weight != "" %}custom-font-weight{% endif %}
      "
      style="
        {% render 'typography-style', settings: block_settings, preset: 'custom' %}
        --line-height: 1;
      "
      {% if item_tag == 'a' %}href="{{ block_settings.link }}"{% endif %}
      {{ block.shopify_attributes }}
    >{% render 'birdlabs-announcement-content', block_settings: block_settings, section: section %}</{{ item_tag }}>
  {%- else -%}
    <slideshow-slide
      ref="slides[]"
      class="
        birdlabs-announcement-bar__slide
        custom-typography
        {% if block_settings.font_size != "" %}custom-font-size{% endif %}
        {% if block_settings.weight != "" %}custom-font-weight{% endif %}
      "
      style="
        {% render 'typography-style', settings: block_settings, preset: 'custom' %}
        --line-height: 1;
      "
      {{ block.shopify_attributes }}
      aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
    >
      <div class="birdlabs-announcement-bar__item">
        {% render 'birdlabs-announcement-content', block_settings: block_settings, section: section %}
      </div>

      {% if block_settings.link != blank %}
        <a
          class="birdlabs-announcement-bar__link"
          href="{{ block_settings.link }}"
        >
          <span class="visually-hidden">
            {{ plain_pre }} {{ discount_code }} {{ plain_post }}
          </span>
        </a>
      {% endif %}
    </slideshow-slide>
  {%- endif -%}
{%- endunless -%}

{% stylesheet %}
  /*
    This item deliberately does NOT use the theme's shared .text-block class.
    .text-block sets display:flex/flex-direction:column (built for stacking a
    heading over a paragraph) and its ".text-block > *" rule sets text-wrap on
    direct children, which permits wrapping and beats an inherited nowrap because
    a direct declaration always wins over an inherited one regardless of
    specificity. Both together produced two confirmed bugs: the three parts
    stacking as separate lines, and pre-text/post-text each wrapping onto a
    second line on narrow viewports even after the first bug was fixed. Owning
    display/wrap/typography directly here, without that shared class, avoids
    fighting either rule instead of trying to out-specificity them.
  */
  /*
    3-column grid (pre-text | discount-code | post-text), spanning the item's
    full width — shared by both the marquee item and the slideshow item, so
    the child span classes below (.birdlabs-marquee__pre-text etc., emitted by
    snippets/birdlabs-announcement-content.liquid) work identically in either
    mode. The discount code always renders into the middle column, so its
    center lands on the item's own horizontal center. min-width: 0 + overflow:
    hidden on the outer columns matter just as much as the 1fr sizing itself —
    without them a grid track defaults to its content's full min-content
    width, which drags the discount code off-center the moment pre-text or
    post-text gets long. With them, the longer side simply clips at its own
    edge instead of pushing the discount code.
  */
  .birdlabs-marquee__item,
  .birdlabs-announcement-bar__item {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    width: 100%;
    column-gap: 0.35em;
  }

  .birdlabs-marquee__pre-text,
  .birdlabs-marquee__discount-code,
  .birdlabs-marquee__post-text {
    white-space: nowrap;
  }

  .birdlabs-marquee__pre-text,
  .birdlabs-marquee__post-text {
    min-width: 0;
    overflow: hidden;
  }

  .birdlabs-marquee__discount-code--glow {
    text-shadow:
      0 0 4px rgb(var(--color-rgb, var(--color-foreground-rgb)) / 0.9),
      0 0 11px rgb(var(--color-rgb, var(--color-foreground-rgb)) / 0.75),
      0 0 19px rgb(var(--color-rgb, var(--color-foreground-rgb)) / 0.55),
      0 0 40px rgb(var(--color-rgb, var(--color-foreground-rgb)) / 0.35);
  }

  /*
    Task 0024 follow-up: a glow-intensity-only pulse (first version of this
    effect) turned out too subtle to notice in practice — human vision reads
    hue changes far more readily than blur-radius changes. Now animates
    `color` between --pulse-color-a/-b (set by snippets/birdlabs-announcement-content.liquid
    from discount_text_color and the new discount_pulse_color setting) as well
    as the glow intensity, so there's an unmistakable color shift plus the
    original breathing glow on top. If discount_pulse_color is left blank,
    the snippet sets --pulse-color-b equal to --pulse-color-a, so the color
    never visibly changes and this degrades gracefully to the original
    glow-only pulse rather than doing nothing. Works independently of the
    static glow checkbox — if both are checked, the animation simply
    overrides the static shadow while running, so pulse wins with no visual
    conflict.
  */
  .birdlabs-marquee__discount-code--pulse {
    animation: birdlabs-discount-pulse 1.6s ease-in-out infinite;
  }

  @keyframes birdlabs-discount-pulse {
    0%,
    100% {
      color: var(--pulse-color-a, currentColor);
      text-shadow:
        0 0 4px rgb(var(--pulse-color-a-rgb, var(--color-rgb, var(--color-foreground-rgb))) / 0.9),
        0 0 11px rgb(var(--pulse-color-a-rgb, var(--color-rgb, var(--color-foreground-rgb))) / 0.75),
        0 0 19px rgb(var(--pulse-color-a-rgb, var(--color-rgb, var(--color-foreground-rgb))) / 0.55),
        0 0 40px rgb(var(--pulse-color-a-rgb, var(--color-rgb, var(--color-foreground-rgb))) / 0.35);
    }

    50% {
      color: var(--pulse-color-b, currentColor);
      text-shadow:
        0 0 7px rgb(var(--pulse-color-b-rgb, var(--color-rgb, var(--color-foreground-rgb))) / 1),
        0 0 18px rgb(var(--pulse-color-b-rgb, var(--color-rgb, var(--color-foreground-rgb))) / 0.95),
        0 0 32px rgb(var(--pulse-color-b-rgb, var(--color-rgb, var(--color-foreground-rgb))) / 0.85),
        0 0 65px rgb(var(--pulse-color-b-rgb, var(--color-rgb, var(--color-foreground-rgb))) / 0.65);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .birdlabs-marquee__discount-code--glow,
    .birdlabs-marquee__discount-code--pulse {
      text-shadow: none;
      animation: none;
    }
  }

  /*
    Non-marquee (slideshow) mode item — ported from header-announcements.liquid's
    .announcement-bar__slide. Stacks every slide in the same grid cell (parent
    section's .birdlabs-announcement-bar__slides sets grid: [stack] auto /
    [stack] auto) and cross-fades on the aria-hidden toggle that
    assets/announcement-bar.js drives.
  */
  .birdlabs-announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;
    place-content: center;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .birdlabs-announcement-bar__link {
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}

