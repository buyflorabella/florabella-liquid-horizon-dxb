

{% render 'text-block-styles' %}

{%- assign block_settings = block.settings -%}
{%- assign pre_text = block_settings.pre_text -%}
{%- assign discount_code = block_settings.discount_code | strip -%}
{%- assign post_text = block_settings.post_text -%}
{%- assign discount_font_size = block_settings.discount_font_size -%}
{%- assign discount_weight = block_settings.discount_weight -%}
{%- assign item_tag = 'span' -%}
{%- if block_settings.link != blank -%}
  {%- assign item_tag = 'a' -%}
{%- endif -%}

{%- assign plain_pre = pre_text | strip_newlines | strip_html | strip -%}
{%- assign plain_post = post_text | strip_newlines | strip_html | strip -%}

{%- unless plain_pre == '' and discount_code == '' and plain_post == '' -%}
  <{{ item_tag }}
    class="
      birdlabs-marquee__item
      text-block
      custom-typography
      {% if block_settings.font_size != "" %}custom-font-size{% endif %}
      {% if block_settings.weight != "" %}custom-font-weight{% endif %}
    "
    style="
      {% render 'typography-style', settings: block_settings, preset: 'custom' %}
      {% if block_settings.text_color != blank %}--color: {{ block_settings.text_color }}; --color-rgb: {{ block_settings.text_color.rgb }};{% endif %}
      --width: auto;
      --text-align: left;
      --line-height: 1;
    "
    {% if item_tag == 'a' %}href="{{ block_settings.link }}"{% endif %}
    {{ block.shopify_attributes }}
  >{%- if plain_pre != '' -%}<span class="birdlabs-marquee__pre-text">{{ pre_text }}</span>{%- endif -%}{%- if discount_code != '' -%}<span
      class="birdlabs-marquee__discount-code{% if discount_font_size != blank %} custom-font-size{% endif %}{% if discount_weight != blank %} custom-font-weight{% endif %}"
      style="{% if discount_font_size != blank %}--font-size: {{ discount_font_size }};{% endif %}{% if discount_weight != blank %}--font-weight: {{ discount_weight }};{% endif %}"
    >{{ discount_code }}</span>{%- endif -%}{%- if plain_post != '' -%}<span class="birdlabs-marquee__post-text">{{ post_text }}</span>{%- endif -%}</{{ item_tag }}>
{%- endunless -%}

