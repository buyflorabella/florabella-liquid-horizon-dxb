
{% render 'text-block-styles' %}

{%- comment -%}
  Renders text-block-styles for its .custom-color rule (used by the color pickers
  below), but this item deliberately never carries the "text-block" class itself —
  see the note in the stylesheet block further down for why.
{%- endcomment -%}

{%- assign block_settings = block.settings -%}
{%- assign pre_text = block_settings.pre_text -%}
{%- assign discount_code = block_settings.discount_code | strip -%}
{%- assign post_text = block_settings.post_text -%}
{%- assign discount_font_size = block_settings.discount_font_size -%}
{%- assign discount_weight = block_settings.discount_weight -%}
{%- assign pre_color = block_settings.pre_text_color -%}
{%- assign discount_color = block_settings.discount_text_color -%}
{%- assign post_color = block_settings.post_text_color -%}
{%- assign item_tag = 'span' -%}
{%- if block_settings.link != blank -%}
  {%- assign item_tag = 'a' -%}
{%- endif -%}

{%- comment -%}
  The discount code always sits in the middle grid column (column 2) so its
  center lands on the bar's center regardless of viewport width — see the
  stylesheet note below. Direction only swaps which OUTER column pre-text vs.
  post-text renders into; it never moves the discount code itself.
{%- endcomment -%}
{%- assign marquee_direction = section.settings.direction | default: 'left' -%}
{%- assign pre_grid_column = 1 -%}
{%- assign post_grid_column = 3 -%}
{%- if marquee_direction == 'right' -%}
  {%- assign pre_grid_column = 3 -%}
  {%- assign post_grid_column = 1 -%}
{%- endif -%}

{%- assign plain_pre = pre_text | strip_newlines | strip_html | strip -%}
{%- assign plain_post = post_text | strip_newlines | strip_html | strip -%}

{%- unless plain_pre == '' and discount_code == '' and plain_post == '' -%}
  <{{ item_tag }}
    class="
      birdlabs-marquee__item
      custom-typography
      {% if block_settings.font_size != "" %}custom-font-size{% endif %}
      {% if block_settings.weight != "" %}custom-font-weight{% endif %}
    "
    style="
      {% render 'typography-style', settings: block_settings, preset: 'custom' %}
      --line-height: 1;
    "
    {% if item_tag == 'a' %}href="{{ block_settings.link }}"{% endif %}
    {{ block.shopify_attributes }}
  >{%- if plain_pre != '' -%}<span
      class="birdlabs-marquee__pre-text{% if pre_color != blank %} custom-color{% endif %}"
      style="grid-column: {{ pre_grid_column }}; justify-self: {% if pre_grid_column == 1 %}end{% else %}start{% endif %};{% if pre_color != blank %} --color: {{ pre_color }}; --color-rgb: {{ pre_color.rgb }};{% endif %}"
    >{{ pre_text }}</span>{%- endif -%}{%- if discount_code != '' -%}<span
      class="
        birdlabs-marquee__discount-code
        {% if discount_font_size != blank %}custom-font-size{% endif %}
        {% if discount_weight != blank %}custom-font-weight{% endif %}
        {% if discount_color != blank %}custom-color{% endif %}
        {% if block_settings.discount_glow %}birdlabs-marquee__discount-code--glow{% endif %}
      "
      style="
        grid-column: 2;
        {% if discount_font_size != blank %}--font-size: {{ discount_font_size }};{% endif %}
        {% if discount_weight != blank %}--font-weight: {{ discount_weight }};{% endif %}
        {% if discount_color != blank %}--color: {{ discount_color }}; --color-rgb: {{ discount_color.rgb }};{% endif %}
      "
    >{{ discount_code }}</span>{%- endif -%}{%- if plain_post != '' -%}<span
      class="birdlabs-marquee__post-text{% if post_color != blank %} custom-color{% endif %}"
      style="grid-column: {{ post_grid_column }}; justify-self: {% if post_grid_column == 1 %}end{% else %}start{% endif %};{% if post_color != blank %} --color: {{ post_color }}; --color-rgb: {{ post_color.rgb }};{% endif %}"
    >{{ post_text }}</span>{%- endif -%}</{{ item_tag }}>
{%- endunless -%}

{% stylesheet %}
  /*
    This item deliberately does NOT use the theme's shared .text-block class.
    .text-block sets display:flex/flex-direction:column (built for stacking a
    heading over a paragraph) and its ".text-block > *" rule sets text-wrap on
    direct children, which permits wrapping and beats an inherited nowrap because
    a direct declaration always wins over an inherited one regardless of
    specificity. Both together produced two confirmed bugs: the three parts
    stacking as separate lines, and pre-text/post-text each wrapping onto a
    second line on narrow viewports even after the first bug was fixed. Owning
    display/wrap/typography directly here, without that shared class, avoids
    fighting either rule instead of trying to out-specificity them.
  */
  /*
    3-column grid (pre-text | discount-code | post-text), spanning the item's
    full width. The discount code always renders into the middle column, so its
    center lands on the item's own horizontal center — and since the item and
    its ancestor track/bar are all full-bleed (see the section's stylesheet),
    the item's center IS the viewport's center, on both mobile and desktop, in
    both marquee's resting/held state and in fully static mode. min-width: 0 +
    overflow: hidden on the outer columns matter just as much as the 1fr sizing
    itself — without them a grid track defaults to its content's full
    min-content width, which drags the discount code off-center the moment
    pre-text or post-text gets long. With them, the longer side simply clips at
    its own edge instead of pushing the discount code.
  */
  .birdlabs-marquee__item {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    width: 100%;
    column-gap: 0.35em;
  }

  .birdlabs-marquee__pre-text,
  .birdlabs-marquee__discount-code,
  .birdlabs-marquee__post-text {
    white-space: nowrap;
  }

  .birdlabs-marquee__pre-text,
  .birdlabs-marquee__post-text {
    min-width: 0;
    overflow: hidden;
  }

  .birdlabs-marquee__discount-code--glow {
    text-shadow:
      0 0 4px rgb(var(--color-rgb, var(--color-foreground-rgb)) / 0.9),
      0 0 11px rgb(var(--color-rgb, var(--color-foreground-rgb)) / 0.75),
      0 0 19px rgb(var(--color-rgb, var(--color-foreground-rgb)) / 0.55),
      0 0 40px rgb(var(--color-rgb, var(--color-foreground-rgb)) / 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .birdlabs-marquee__discount-code--glow {
      text-shadow: none;
    }
  }
{% endstylesheet %}

